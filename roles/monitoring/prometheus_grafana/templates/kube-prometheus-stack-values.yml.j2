fullnameOverride: monitoring

alertmanager:
  enabled: false

grafana:
  enabled: false

prometheus:
  enabled: true
  service:
    type: NodePort
    nodePort: {{ monitoring_prometheus_node_port }}
  serviceMonitor:
    interval: "{{ monitoring_interval }}"
    selfMonitor: true
  prometheusSpec:
    externalLabels:
      cluster: core
    scrapeInterval: "{{ monitoring_interval }}"
    evaluationInterval: "{{ monitoring_interval }}"
    retention: "{{ monitoring_retention }}"
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    serviceMonitorNamespaceSelector: {}
    podMonitorNamespaceSelector: {}
    nodeSelector:
      {{ monitoring_node_label_key }}: "{{ monitoring_node_label_value }}"
    tolerations:
      - key: "node-role.kubernetes.io/control-plane"
        operator: "Exists"
        effect: "NoSchedule"
{% if monitoring_persistence_enabled | bool %}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: "{{ monitoring_storage_class }}"
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: "{{ monitoring_prometheus_storage_size }}"
{% endif %}
    additionalScrapeConfigs:
      - job_name: "kubernetes-annotated-services"
        scrape_interval: "{{ monitoring_interval }}"
        kubernetes_sd_configs:
          - role: service
            namespaces:
              names:
{% for namespace in monitoring_scrape_namespaces | unique %}
                - "{{ namespace }}"
{% endfor %}
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: "true"
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: "(.+)"
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: "([^:]+)(?::\\d+)?;(\\d+)"
            replacement: "$1:$2"
          - action: labelmap
            regex: __meta_kubernetes_service_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_service_name]
            action: replace
            target_label: service
      - job_name: "kubernetes-annotated-pods"
        scrape_interval: "{{ monitoring_interval }}"
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names:
{% for namespace in monitoring_scrape_namespaces | unique %}
                - "{{ namespace }}"
{% endfor %}
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: "true"
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: "(.+)"
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: "([^:]+)(?::\\d+)?;(\\d+)"
            replacement: "$1:$2"
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: pod

nodeExporter:
  enabled: {{ monitoring_node_exporter_enabled | bool | lower }}

prometheus-node-exporter:
  extraArgs:
    - --collector.pressure
    - --collector.schedstat
    - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/docker/.+|var/lib/kubelet/.+)($|/)
    - --collector.filesystem.fs-types-exclude=^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$
  prometheus:
    monitor:
      interval: "{{ monitoring_infrastructure_interval }}"
      scrapeTimeout: "{{ monitoring_infrastructure_scrape_timeout }}"
      relabelings:
        - sourceLabels: [__meta_kubernetes_pod_node_name]
          targetLabel: node

kubeStateMetrics:
  enabled: true

kube-state-metrics:
  prometheus:
    monitor:
      interval: "{{ monitoring_infrastructure_interval }}"
      scrapeTimeout: "{{ monitoring_infrastructure_scrape_timeout }}"

kubeApiServer:
  enabled: false

coreDns:
  enabled: false

kubeControllerManager:
  enabled: false

kubeEtcd:
  enabled: false

kubeProxy:
  enabled: false

kubeScheduler:
  enabled: false

kubelet:
  enabled: true
  serviceMonitor:
    cAdvisor: true
    # Keep throttled time; retain the other drop rules from chart 51.9.4.
    cAdvisorMetricRelabelings:
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_cpu_(load_average_10s|system_seconds_total|user_seconds_total)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_memory_(mapped_file|swap)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_(file_descriptors|tasks_state|threads_max)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_spec.*'
      - sourceLabels: [id, pod]
        action: drop
        regex: '.+;'

prometheusOperator:
  kubeletService:
    enabled: true

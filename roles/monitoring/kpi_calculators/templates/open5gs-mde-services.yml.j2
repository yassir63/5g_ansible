apiVersion: v1
kind: Service
metadata:
  name: amf-metrics-service
  namespace: {{ monitoring_core_namespace }}
  labels:
    nf: amf
    app: monitoring
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/scheme: "http"
    prometheus.io/path: "/metrics"
    prometheus.io/port: "9090"
spec:
  ports:
    - name: metrics
      port: 9090
  selector:
    nf: amf
---
